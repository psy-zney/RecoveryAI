{
  "name": "resc-mcp",
  "version": "1.0.0",
  "description": "Read-only disk forensics MCP engine with native NTFS/FAT RAM-overlay validation",
  "repository": {
    "type": "git",
    "url": "https://github.com/psy-zney/resc.git"
  },
  "main": "bin/recoveryai-mcp.js",
  "bin": {
    "resc": "./bin/recoveryai-mcp.js",
    "resc-mcp": "./bin/recoveryai-mcp.js",
    "recoveryai-mcp": "./bin/recoveryai-mcp.js"
  },
  "type": "commonjs",
  "files": [
    "bin/",
    "README.md",
    "AGENTS.md",
    "mcp_config.json",
    "docs/engine-capabilities.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node ./bin/recoveryai-mcp.js",
    "inspect": "npx @modelcontextprotocol/inspector node ./bin/recoveryai-mcp.js",
    "build:rust": "cargo build --release",
    "test:e2e": "python tests/test_e2e_recovery.py"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "data-recovery",
    "disk-forensics",
    "ntfs",
    "fat32",
    "exfat",
    "simd",
    "rust",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "author": "RecoveryAI Core Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  }
}

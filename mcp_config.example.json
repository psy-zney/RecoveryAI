{
  "mcpServers": {
    "resc": {
      "command": "node",
      "args": ["<absolute-path-to-resc>/bin/resc-mcp.js"],
      "env": {
        "RESC_MCP_BIN": "<absolute-path-to-trusted-mcp-server-binary>",
        "RESC_SESSION_ROOT": "<absolute-path-to-persistent-resc-state>",
        "RUST_LOG": "info"
      }
    }
  }
}
